generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  TempleManager
  BusinessManager
}

enum TempleStatus {
  Pending
  Approved
  Delist
  Rejected
}

enum RegistrationStatus {
  Pending
  Approved
  Rejected
}

enum EventStatus {
  Pending
  Approved
  Rejected
  Cancelled
  Completed
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  email         String?  @unique
  passwordHash  String
  role          Role     @default(Admin)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reviewedMandirRegistrations UserMandirRegistration[] @relation("ReviewedMandirUser")
  events Event[] @relation("EventOrganizer")
  reviewedEvents Event[] @relation("EventReviewer")
}

model City {
  id   Int    @id @default(autoincrement())
  name String @unique
  temples Temple[]

  @@map("temple_city")
}

model Deity {
  id   Int    @id @default(autoincrement())
  name String @unique
  temples Temple[]

  @@map("temple_deity")
}

model Temple {
  id                 Int          @id @default(autoincrement())
  mandir_name        String
  status             TempleStatus @default(Pending)
  full_address       String
  cityId             Int          @map("city_id")
  year_established   Int
  mainDeityId        Int          @map("main_deity_id")
  description        String
  phone_no           String
  email              String       @unique
  website            String
  opening_hours      String
  service_offered    String
  facilities_offered String
  your_name          String
  your_email         String
  rating             Float        @default(0)
  location           String
  role               String       @default("devotee")

  city      City         @relation(fields: [cityId], references: [id], onDelete: Cascade)
  mainDeity Deity        @relation(fields: [mainDeityId], references: [id], onDelete: Cascade)
  images    TempleImage[]
  mandirRegistrations UserMandirRegistration[]

  @@map("temple_temple")
}

model Event {
  id                  Int         @id @default(autoincrement())
  title               String
  category            String
  description         String       @db.Text
  imageUrl            String?      @db.VarChar(2048)
  status              EventStatus  @default(Pending)
  eventDate           String
  startTime           String
  endTime             String
  multiDay            Boolean      @default(false)
  endDate             String?
  recurring           Boolean      @default(false)
  frequency           String?
  registrationOpens   String?
  registrationCloses  String?
  templeName          String
  hallName            String?
  address             String?
  mapsLink            String?      @db.VarChar(2048)
  onlineLink          String?      @db.VarChar(2048)
  attendees           Int          @default(0)
  organizerId         Int?         @map("organizer_id")
  reviewedById        Int?         @map("reviewed_by_id")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  organizer User? @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  reviewer  User? @relation("EventReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([organizerId])
  @@map("community_event")
}

model RelationToMandir {
  id               Int                     @id @default(autoincrement())
  relationshipName String                  @unique @map("relationship_name")
  isActive         Boolean                 @default(true) @map("is_active")
  registrations    UserMandirRegistration[]

  @@map("relation_to_mandir")
}

model UserMandirRegistration {
  id            Int                @id @default(autoincrement())
  firstName     String             @map("first_name")
  lastName      String             @map("last_name")
  email         String
  mobile        String
  status        RegistrationStatus @default(Pending)
  relationId    Int                @map("relation_id")
  mandirId      Int                @map("mandir_id")
  reviewedByUserId Int?             @map("reviewed_by_user_id")
  reviewedAt    DateTime?          @map("reviewed_at")
  notes         String?            @db.Text
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  relation       RelationToMandir @relation(fields: [relationId], references: [id], onDelete: Restrict)
  mandir         Temple           @relation(fields: [mandirId], references: [id], onDelete: Restrict)
  reviewedByUser User?            @relation("ReviewedMandirUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([mandirId, status])
  @@index([relationId, status])
  @@index([status])
  @@index([email])
  @@map("user_mandir_registration")
}

model Business {
  id             BigInt   @id @default(autoincrement())
  businessName   String
  category       String
  description    String
  address        String
  city           String
  phone          String
  email          String
  website        String?
  ownerName      String
  ownerEmail     String
  ownerPhone     String
  services       String?
  operatingHours String?
  specialOffers  String?
  facebookUrl    String?
  instagramUrl   String?
  twitterUrl     String?
  status         String
  approvedat     DateTime?
  created_at     DateTime
  reviewedat     DateTime?
  reviewnotes    String?

  @@map("business_business")
}

model TempleImage {
  id       Int    @id @default(autoincrement())
  templeId Int    @map("temple_id")
  file     String
  temple   Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@map("temple_templeimage")
}
